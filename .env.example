# Meta Model API (https://dev.meta.ai): server-side only, never shipped to a browser.
# MODEL_API_KEY (the name Meta's docs use) is also accepted.
META_API_KEY=
# Defaults to https://api.meta.ai/v1
META_API_BASE_URL=

# Model ids. Run `npm run models` once your key works and fill in the exact ids.
META_TEXT_MODEL_NARRATOR=muse-spark-1.3
META_TEXT_MODEL_PLANNER=muse-wonder-1.0
# Spark checks both user prompts and proposed branches; Wonder proposes/reviews.
META_TEXT_MODEL_POLICY_PROMPT=muse-spark-1.3
META_TEXT_MODEL_POLICY_BRANCHES=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENT_MODEL=sam-3.1

# Spend guard for the Meta Model API (cumulative ledger ceiling in out/spend.json).
# Calls are refused before dispatch once cumulative + reserved spend would exceed this ceiling.
META_SPEND_CAP_USD=100
# Optional UTC daily ceiling (USD). When left blank, defaults to META_SPEND_CAP_USD.
DEMO_DAILY_CAP_USD=
# Muse Image application estimate per generated image (USD); actual provider charges may differ.
META_IMAGE_COST_USD=0.01
# Conservative per-call estimate (USD) for SAM 3.1 segmentation.
META_SEGMENT_COST_USD=0.05

# Topic policy, per deployment (not a user toggle). Hackathon build: leave empty = block war and politics.
# Options: war,politics (default) | war | politics | none
TOPIC_POLICY_BLOCK=

# Optional: hand-off to the existing Chronos 3D pipeline (private; not part of this repo).
# Live Meta text/image/cutout/voice generation works with META_API_KEY alone while DEMO_3D_ENABLED=false.
CHRONOS_3D_ENDPOINT=
CHRONOS_API_BASE=
CHRONOS_API_TOKEN=
CHRONOS_3D_PROVIDER=trellis
CHRONOS_3D_MAX_JOBS=6
# Set true only after confirming the deployed TRELLIS relic path is real and enabled.
CHRONOS_3D_CAPABILITY_CONFIRMED=
# Optional comma-separated trusted HTTPS origins for external model artifacts.
CHRONOS_3D_ARTIFACT_ORIGINS=

# Optional access code for non-loopback or gated live runs. When bound to 127.0.0.1 with META_API_KEY set,
# same-origin local browser sessions are authorized automatically on loopback.
DEMO_ACCESS_CODE=
# Voice prompt transcription via muse-voice-transcribe-1.0 (enabled automatically on 127.0.0.1 when META_API_KEY is set).
DEMO_VOICE_ENABLED=true
# Set true to force replay-only mode even when META_API_KEY is present. Without META_API_KEY, replay-only mode is automatic.
DEMO_REPLAY_ONLY=false
# Optional request throttle per IP per minute. Defaults to 60 with HOST=127.0.0.1 and a Meta key; 5 otherwise.
# Uncomment to override with a positive integer: DEMO_RATE_LIMIT=60
# Optional 3D handoff; Meta-only live runs do not need Chronos credentials.
DEMO_3D_ENABLED=false
HOST=127.0.0.1
PORT=3000
