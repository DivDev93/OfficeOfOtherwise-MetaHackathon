# Meta Model API (https://dev.meta.ai): server-side only, never shipped to a browser.
# MODEL_API_KEY (the name Meta's docs use) is also accepted.
META_API_KEY=
# Defaults to https://api.meta.ai/v1
META_API_BASE_URL=

# Model ids. Run `npm run models` once your key works and fill in the exact ids.
META_TEXT_MODEL_PLANNER=muse-wonder-1.0
# Spark checks both user prompts and proposed branches; Wonder proposes/reviews.
META_TEXT_MODEL_POLICY_PROMPT=muse-spark-1.3
META_TEXT_MODEL_POLICY_BRANCHES=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENT_MODEL=sam-3.1

# Spend guard for the hackathon credits ($150 grant). Calls are refused before they're sent once this would be exceeded.
META_SPEND_CAP_USD=100
# Muse Image price per generated image (USD); override if pricing changes.
META_IMAGE_COST_USD=0.01
# Conservative per-call estimate (USD); check Meta's published image pricing.
META_SEGMENT_COST_USD=0.05

# Topic policy, per deployment (not a user toggle). Hackathon build: leave empty = block war and politics.
# Options: war,politics (default) | war | politics | none
TOPIC_POLICY_BLOCK=

# Optional: hand-off to the existing Chronos 3D pipeline (private; not part of this repo)
CHRONOS_3D_ENDPOINT=
CHRONOS_API_BASE=
CHRONOS_API_TOKEN=
CHRONOS_3D_PROVIDER=trellis
CHRONOS_3D_MAX_JOBS=6
# Set true only after confirming the deployed TRELLIS relic path is real and enabled.
CHRONOS_3D_CAPABILITY_CONFIRMED=
# Optional comma-separated trusted HTTPS origins for external model artifacts.
CHRONOS_3D_ARTIFACT_ORIGINS=

# Live demo access is disabled when this is empty; replay remains available.
DEMO_ACCESS_CODE=
# The container defaults to replay-only even when secrets are configured.
DEMO_REPLAY_ONLY=false
# Optional 3D handoff; Meta-only live runs do not need Chronos credentials.
DEMO_3D_ENABLED=false
DEMO_DAILY_CAP_USD=3
HOST=127.0.0.1
PORT=3000
