# Meta Model API (https://dev.meta.ai) — server-side only, never shipped to a browser
META_API_KEY=
META_API_BASE_URL=
META_TEXT_MODEL_PLANNER=muse-wonder
META_TEXT_MODEL_NARRATOR=muse-spark
META_IMAGE_MODEL=muse-image
META_SEGMENT_MODEL=sam-3.1

# Spend guard for the hackathon credits ($150 grant). Calls stop once this is reached.
META_SPEND_CAP_USD=100

# Optional: hand-off to the existing Chronos 3D pipeline (private; not part of this repo)
CHRONOS_3D_ENDPOINT=
