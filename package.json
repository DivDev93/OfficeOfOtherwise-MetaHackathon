{
  "name": "office-of-otherwise",
  "version": "0.0.0",
  "description": "Office of Otherwise — Meta-model-powered alternate-history branching for Chronos. Meta Global AI Developer Hackathon 2026.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9.0"
  },
  "exports": {
    "./providers/*": "./src/providers/*.js",
    "./agents/*": "./src/agents/*.js",
    "./guardrails/*": "./src/guardrails/*.js",
    "./lib/*": "./src/lib/*.js"
  },
  "scripts": {
    "test": "node --test",
    "harness": "node --env-file-if-exists=.env harness/run.js",
    "demo": "node --env-file-if-exists=.env server/index.js",
    "demo:replay": "node server/replay.js",
    "cache-demo": "node --env-file-if-exists=.env scripts/cache-demo.js",
    "cache-guardrail-fixture": "node scripts/cache-guardrail-fixture.js",
    "init-demo-budget": "node scripts/init-demo-budget.js",
    "models": "node --env-file-if-exists=.env scripts/models.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "branch": "node --env-file-if-exists=.env scripts/branch.js",
    "attach-glb": "node scripts/attach-glb.js"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "pngjs": "7.0.0"
  }
}
